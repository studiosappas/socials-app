{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/app/projects/[projectId]/grid/grid-reducer.test.ts",
    "src/app/projects/[projectId]/grid/grid-interaction.test.ts",
    "src/lib/crop-geometry.test.ts",
    "src/lib/ai/result-safety.test.ts",
    "src/lib/upload-insert-order.test.ts",
    "src/lib/media-drop.test.ts",
    "src/lib/upload-validation.test.ts",
    "src/lib/post-export-plan.test.ts",
    "src/lib/project-list-filter.test.ts",
    "src/lib/media-library-paging.test.ts",
    "src/lib/post-type.test.ts",
    "src/lib/annotation-frame.test.ts",
    "src/lib/media-aspect.test.ts",
    "src/lib/cover-framing.test.ts",
    "src/lib/native-share-device.test.ts",
    "src/lib/aspect-ratio.test.ts",
    "src/app/projects/[projectId]/posts/[postId]/post-media-viewer-model.test.ts"
  ]
}
